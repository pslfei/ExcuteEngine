<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="7.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TDServer.Service\TDServer.Service.csproj" />
    <ProjectReference Include="..\FunctionCode\FunctionCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\TDServer.Service\wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="..\TDServer.Service\wwwroot\static\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Common.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="..\TDServer.Service\wwwroot\asset-manifest.json" />
    <Content Remove="..\TDServer.Service\wwwroot\favicon.ico" />
    <Content Remove="..\TDServer.Service\wwwroot\index.html" />
    <Content Remove="..\TDServer.Service\wwwroot\logo192.png" />
    <Content Remove="..\TDServer.Service\wwwroot\logo512.png" />
    <Content Remove="..\TDServer.Service\wwwroot\manifest.json" />
    <Content Remove="..\TDServer.Service\wwwroot\robots.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="cfg.ini" />
    <None Remove="mirrors.dll" />
    <None Remove="pointMSG.csv" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    
  </ItemGroup>

</Project>
